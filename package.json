{
  "name": "hof-city-guide",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "cap:sync": "npm run build && cap sync",
    "screenshots": "node scripts/screenshots.mjs",
    "images": "node scripts/make-images.mjs",
    "android": "npm run build && cap sync android && cap open android",
    "ios": "npm run build && cap sync ios && cap open ios",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@capacitor/geolocation": "^6.0.1",
    "@capacitor/ios": "^6.1.2",
    "pinia": "^2.2.2",
    "vue": "^3.4.38",
    "vue-i18n": "^9.14.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2",
    "@eslint/js": "^9.39.5",
    "@types/google.maps": "^3.66.5",
    "@vitejs/plugin-vue": "^5.1.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-vue": "^9.33.0",
    "playwright-core": "^1.64.0",
    "prettier": "^3.9.9",
    "typescript": "~5.5.4",
    "typescript-eslint": "^8.71.1",
    "vite": "^5.4.2",
    "vue-tsc": "^2.0.29"
  },
  "description": "City guide for Hof (Bavaria) - Vue 3, TypeScript and Capacitor",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  }
}
